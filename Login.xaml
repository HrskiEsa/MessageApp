<Window x:Class="MessageApp.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MessageApp"
        mc:Ignorable="d"
        Title="Login" Height="200" Width="300">
    <StackPanel>
        <Label Content="Käyttäjätunnus" />
        <TextBox x:Name="txtUsername" Margin="5,0,5,0" Height="25" Text="admin" />
        <Label x:Name="lblPassword" Content="Salasana" />
        <PasswordBox x:Name="txtPassword" Margin="5,0,5,0" Height="25" Password="admin1" />
        <Button Margin="5" Content="Kirjaudu" Height="25" Width="100" HorizontalAlignment="Right" Click="LogIn" />
        
        <TextBlock Margin="5" Text="Lisää uusi käyttäjä" Cursor="Hand" Foreground="Blue" TextDecorations="Underline" Height="15" MouseLeftButtonUp="AddNewUser" HorizontalAlignment="Right"  />
        
        
    </StackPanel>
</Window>
