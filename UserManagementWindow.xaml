<Window x:Class="MessageApp.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MessageApp"
        mc:Ignorable="d"
        Title="Käyttäjähallinta" Height="195" Width="371">
    <Grid>
        <GroupBox Header="Käyttäjän tiedot" Height="127" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="77*"/>
                    <ColumnDefinition Width="282*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Käyttäjätunnus" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
                <Label Content="Salasana" HorizontalAlignment="Center" Margin="0,41,0,0" VerticalAlignment="Top"/>
                <Label Content="Salasana uudelleen" HorizontalAlignment="Left" Margin="10,72,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2"/>

                <TextBox x:Name="txtUserName" Margin="68,10,10,0" Height="26" VerticalAlignment="Top" Grid.Column="1"/>
                <TextBox x:Name="txtPassword" Margin="68,41,10,0" Height="26" VerticalAlignment="Top" Grid.Column="1"/>
                <TextBox x:Name="txtRetypedPassword" Margin="68,72,10,0" Height="26" VerticalAlignment="Top" Grid.Column="1" />
            </Grid>
        </GroupBox>
        <Button Content="OK" HorizontalAlignment="Right" Margin="0,132,19,0" VerticalAlignment="Top" Width="75" Click="OKClicked"/>
        <Label x:Name="lblNotMatch" Visibility="Hidden" Content="SALASANAT EIVÄT TÄSMÄÄ" HorizontalAlignment="Center" Margin="0,129,0,0" VerticalAlignment="Top" Foreground="Red"/>

    </Grid>
</Window>
