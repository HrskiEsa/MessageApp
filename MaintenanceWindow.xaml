<Window x:Class="MessageApp.MaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MessageApp"
        mc:Ignorable="d"
        Title="Sovelluksen ylläpito" Height="150" Width="293">
    <Grid>
        <GroupBox Header="Salasanojen suojaus" Margin="0,10,0,0" HorizontalAlignment="Center" Width="283" Height="111" VerticalAlignment="Top">
            <Canvas>
                <Label Content="Muuta käyttäjien salasanat salatuiksi" Canvas.Left="10" />
                <Button x:Name="btnEncrypt" Content="Salaa salasanat" Canvas.Left="10" Canvas.Top="26" HorizontalAlignment="Left" VerticalAlignment="Top" Width="114" Click="EncryptPasswordsClick"/>
            </Canvas>
        </GroupBox>


    </Grid>
</Window>
